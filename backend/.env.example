# Copy to .env and fill in. Never commit .env.

# --- Core ---
APP_ENV=dev
LOG_LEVEL=INFO
DATA_DIR=./data

# --- Transcription ---
# groq  : Groq Whisper API (recommended; free tier, faster than realtime)
# local : faster-whisper on this machine (needs ~2-4GB RAM, CPU-bound)
# fake  : deterministic stub, used by the test suite
TRANSCRIPTION_PROVIDER=groq
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Conversation analysis (phase 3) ---
# groq   : Groq chat models. Same key as transcription above.
#          NOTE: llama-3.3-70b-versatile is NOT available - verified 404.
# gemini : Google Gemini. Needs GEMINI_API_KEY.
# fake   : scripted response, used by the test suite.
LLM_PROVIDER=groq
GROQ_LLM_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# faster-whisper settings, only used when TRANSCRIPTION_PROVIDER=local
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8

# --- Ingest limits ---
# 20MB keeps a single segment under Groq's 25MB request cap.
MAX_SEGMENT_BYTES=20971520
MAX_SEGMENT_DURATION_S=300

# Seconds of inactivity after which an open session is auto-closed.
SESSION_IDLE_TIMEOUT_S=90

# --- Pipeline ---
PIPELINE_WORKERS=1
JOB_MAX_ATTEMPTS=3
# Base retry delay in seconds, doubled per attempt (429 handling).
JOB_RETRY_BACKOFF_S=2.0

# --- Auth (phase 8) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required, and at least 32 characters, when APP_ENV=prod.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_MINUTES=43200
# When false, endpoints accept a ?user_id= query parameter instead of a token.
# Only for local development; prod refuses to start with this off.
AUTH_REQUIRED=true

# --- Notifications ---
# expo : Expo push service (no credentials needed)
# none : notifications disabled
PUSH_PROVIDER=expo
BRIEFING_CHECK_SECONDS=60

# --- Google Calendar (phase 10) ---------------------------------------
# From Google Cloud console -> Google Auth Platform -> Clients -> Web
# application. Blank means the integration is simply absent and approvals
# fall back to recording locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be HTTPS and must match the console character for character. Google
# permits http:// only for localhost, and a phone cannot reach the laptop's
# localhost - hence the Cloudflare tunnel.
GOOGLE_REDIRECT_URI=http://localhost:8010/v1/integrations/google/callback
GOOGLE_CALENDAR_ID=primary
GOOGLE_TIMEOUT_S=30

# Also request the Gmail scope and enable email drafting. OFF by default.
#
# `gmail.compose` is a RESTRICTED scope that permits drafts.send and
# messages.send, so turning this on grants a token that CAN send mail as
# you. There is no draft-only Gmail scope. Audaxity never calls send, but
# that is a property of this code rather than a limit Google enforces - and
# it commits you to restricted-scope verification plus a security assessment
# before shipping to anyone else.
GOOGLE_ENABLE_GMAIL=false
